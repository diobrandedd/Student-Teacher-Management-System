# Local / development defaults — change for production
APP_ENV=development
APP_URL=http://localhost/Student-Teacher-Management-System/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_secure
# Prefer a dedicated MySQL user with rights only on DB_NAME (not root) in production.
DB_USER=root
DB_PASS=
# Temporary password for new/reset teacher, student, and registrar accounts (until first sign-in change).
# Administrators still get a random one-time temporary password.
DEFAULT_TEMP_PASSWORD=DemoTemp1234
